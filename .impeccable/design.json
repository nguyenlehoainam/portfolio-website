  "narrative": {
    "northStar": "Warm editorial personal archive",
    "overview": "A creative dossier with the tactile calm of paper, photographic keepsakes and handwritten marginal notes. Large serif names and headings establish authorship; precise Vietnamese sans-serif text makes the archive readable and approachable.\n\nBounded grids and a few consolidated surfaces organize content. A dimensional workspace is an authored artifact with computer, camera and design sheet. The independent homepage CSS is the authority; historical scrapbook and concept pages are not the current system.",
    "keyCharacteristics": [
      "Ivory paper, wheat layers and coffee emphasis.",
      "Editorial serif scale with Vietnamese sans-serif clarity.",
      "Consolidated rectangular surfaces and restrained paper rotation.",
      "Natural linear scrolling and accessible controls."
    ],
    "rules": [
      {
        "name": "The Material Hierarchy Rule",
        "body": "Group related content with tonal surfaces before adding another enclosing panel.",
        "section": "colors"
      },
      {
        "name": "The Authored Voice Rule",
        "body": "Use serif and italic emphasis for headings, signatures and marginal notes; keep factual reading and actions in sans-serif.",
        "section": "typography"
      },
      {
        "name": "The Artifact Depth Rule",
        "body": "Concentrate dimensionality in authored artifacts; keep reading surfaces calm and flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do consolidate related content on tonal paper surfaces.",
      "Do keep equal title emphasis across all four disciplines.",
      "Do preserve focus, native disclosures and reduced-motion behavior.",
      "Do preserve portrait pixels and label illustrative project art."
    ],
    "donts": [
      "Don't restore peach, olive or burgundy dominance.",
      "Don't inherit discarded scrapbook layouts or overrides.",
      "Don't turn each role or paragraph into a separate colored card.",
      "Don't invent credentials, achievement badges or project screenshots.",
      "Don't promote decorative kickers, glyph icons or hard offset shadows into reusable patterns."
    ]
  }
